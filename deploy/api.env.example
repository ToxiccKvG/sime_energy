# Secrets du backend. En production, chacun est un paramètre SecureString /sime/api/<NOM>
# dans AWS SSM (eu-west-1) ; charger-secrets.sh génère api.env sur le serveur.
# Les réglages non secrets (FRONTEND_URL, CORS, AUTH_REQUIRED, région, modèle) sont dans compose.yml.
# Ne jamais commiter api.env. Pas de clés AWS : Textract et Bedrock passent par le rôle IAM du serveur.
SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=...
DEEPSEEK_API_KEY=...
# Clé Google (API Calendar seulement), restreinte à l'IP du serveur
GOOGLE_API_KEY=...
