# SITE_ADDRESS : domaine public (ex. 1-2-3-4.sslip.io puis sime.cer2e.com). Caddy obtient le certificat HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Seul /api atteint le backend : /docs, /redoc et /openapi.json restent injoignables depuis Internet
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Fichiers du build (nom = hash du contenu) : cache d'un an, seulement s'ils existent.
		# Un fichier absent (onglet ouvert avant un déploiement) reçoit une vraie 404, et
		# non index.html : le navigateur ne doit jamais mémoriser du HTML à la place du JS.
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# index.html (et toute route de l'application) : revalidé à chaque visite, pour
		# qu'après un déploiement le navigateur reçoive les nouveaux noms de fichiers JS
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# Routes de l'application (/facturation, /audits/…) : servies par index.html
		@spa {
			not path /assets/*
			not file
		}
		rewrite @spa /index.html
		file_server
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://geocoding-api.open-meteo.com https://archive-api.open-meteo.com https://nominatim.openstreetmap.org; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}
}
