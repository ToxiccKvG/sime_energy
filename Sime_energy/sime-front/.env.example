# ============================================================
# Variables d'environnement du front (Vite)
#
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` est ignoré par git : ne jamais le versionner, même si les
# clés ci-dessous sont destinées au navigateur — le jour où un secret
# serveur atterrit dans le même fichier, il partirait dans git sans
# que personne ne s'en aperçoive.
# ============================================================

# Supabase — projet et clé publique (anon).
# La clé anon est embarquée dans le bundle navigateur : elle est
# publique par conception, la sécurité repose sur les policies RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend FastAPI (OCR factures, traitements)
VITE_API_URL=

# Google Calendar API — jours fériés
# Créer une clé sur console.cloud.google.com > APIs & Services > Google Calendar API
# Restreindre la clé à votre domaine (HTTP referrer) : elle est visible côté client.
VITE_GOOGLE_CALENDAR_API_KEY=
